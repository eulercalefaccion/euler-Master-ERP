rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Por defecto: todo cerrado ─────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ─── Adjuntos de formulario público (leads) ────────────────
    // Usuarios anónimos pueden subir archivos aquí (formulario de presupuesto)
    // Límite: 10 MB por archivo, solo tipos comunes (imágenes, PDF, video y planos DWG)
    match /public_leads_attachments/{fileId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*|application/pdf|video/.*')
            || fileId.matches('(?i).*[.]dwg$'));
    }

    // ─── Folletos comerciales (PDF) ────────────────────────────
    match /folletos/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // ─── Archivos de obras ─────────────────────────────────────
    match /obras/{obraId}/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    // ─── Documentos de presupuestos ────────────────────────────
    match /presupuestos/{presupuestoId}/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    // ─── Archivos adjuntos de presupuestos cargados por el equipo ─
    // (planos, fotos, videos que el cliente mandó por WhatsApp/email).
    // Solo usuarios reales del ERP (no anónimos). Máx 50 MB.
    match /presupuestos/{presupuestoId}/archivos/{fileId} {
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ─── Manuales técnicos ─────────────────────────────────────
    match /manuales/{fileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }

    // ─── Facturas de compra y comprobantes de pagos (echeqs) ───
    match /comprobantes_compra_adjuntos/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /pagos_echeqs_adjuntos/{path=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
