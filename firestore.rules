rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCIONES AUXILIARES ─────────────────────────────────────
    
    // Usuario autenticado real (excluye anónimos)
    function isSignedIn() {
      return request.auth != null 
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Usuario autenticado (incluye anónimos)
    function isAnyAuth() {
      return request.auth != null;
    }

    // Administrador: verifica en el documento del usuario en Firestore
    function isAdmin() {
      return isSignedIn() 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrador';
    }

    // Admin o rol operaciones
    function isAdminOrOperaciones() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['administrador', 'operaciones'];
    }

    // ─── REGLA BASE: por defecto todo cerrado ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── USUARIOS ────────────────────────────────────────────────
    match /users/{userId} {
      // Cualquier usuario autenticado real puede leer (necesario para verificar roles)
      allow read: if isSignedIn();
      // Un usuario puede crear su propio documento (registro inicial)
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Un usuario puede actualizar su propio documento PERO NO puede cambiar role ni isActive
      allow update: if isSignedIn() && request.auth.uid == userId 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']);
      // Solo admin puede escribir cualquier campo (incluyendo role e isActive)
      allow write: if isAdmin();
    }

    // ─── COLECCIONES PRINCIPALES (ERP) ───────────────────────────
    
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /presupuestos/{presupuestoId} {
      allow read: if isSignedIn();
      // Admin puede todo. Usuarios anónimos pueden crear (formulario público)
      allow create: if isAdmin() || isAnyAuth();
      allow update: if isAdmin() || (isAnyAuth() && resource.data.estado == 'pendiente');
      allow delete: if isAdmin();
    }

    match /obras/{obraId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // Permitir que encuestas públicas actualicen solo el campo 'encuesta'
      // (Un usuario anónimo autenticado puede agregar la encuesta)
      allow update: if isAnyAuth() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encuesta']);
    }

    match /lista_precios/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /estandares/{estandarId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stock/{stockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transacciones/{trxId} {
      allow read, write: if isAdmin();
    }

    match /liquidaciones/{liquidacionId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      // Cualquier autenticado real puede crear y marcar como leída
      allow create: if isAnyAuth();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /encuestas_obra/{encuestaId} {
      // Las encuestas pueden ser creadas desde el exterior
      allow create: if true; 
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ─── SERVICIOS TÉCNICOS ──────────────────────────────────────
    
    match /servicios/{servicioId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /usuarios/{usuarioId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /papelera/{papeleraId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /manuales/{manualId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── CRM Y AUXILIARES ────────────────────────────────────────
    
    match /folletos/{folletoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /crmLabels/{labelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /metadata/{metadataId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /configuracion/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /colaboradores/{colabId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
