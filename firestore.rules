rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCIONES AUXILIARES ─────────────────────────────────────
    
    // Usuario autenticado real (excluye anónimos)
    function isSignedIn() {
      return request.auth != null 
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Usuario autenticado (incluye anónimos)
    function isAnyAuth() {
      return request.auth != null;
    }

    // Superadministradores por correo (dueño / desarrollador - únicos autorizados para nombrar administradores)
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'nicolas@euler.com.ar',
        'info@euler.com.ar',
        'nfayala@gmail.com'
      ];
    }

    // Administradores autorizados del sistema
    function isAdmin() {
      return isSignedIn() 
        && (
          isSuperAdmin()
          || request.auth.token.email in [
            'admin@eulercalefaccion.com',
            'cindeaalvarez07@gmail.com',
            'cindea.alvarez@euler.com.ar',
            'agustin.ayala@euler.com.ar'
          ]
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrador'
        );
    }

    // ─── REGLA BASE: por defecto todo cerrado ────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── USUARIOS ────────────────────────────────────────────────
    match /users/{userId} {
      // Cualquier usuario autenticado real puede leer (necesario para verificar roles)
      allow read: if isSignedIn();
      
      // Creación de usuario:
      // - Superadmin puede crear con cualquier rol (incluido administrador).
      // - Otros admins o autoregistro solo pueden crearse con rol no-administrador.
      allow create: if isSignedIn() && (
        isSuperAdmin()
        || (isAdmin() && (!('role' in request.resource.data) || request.resource.data.role != 'administrador'))
        || (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role != 'administrador'))
      );

      // Modificación de usuarios:
      // - Superadmin puede modificar cualquier usuario y asignar cualquier rol.
      // - Otros admins solo pueden editar usuarios que NO sean administradores y NO pueden asignar rol administrador.
      // - El propio usuario solo puede editar datos personales (sin tocar role ni isActive).
      allow update: if isSignedIn() && (
        isSuperAdmin()
        || (
          isAdmin() 
          && (!('role' in resource.data) || resource.data.role != 'administrador')
          && (!('role' in request.resource.data) || request.resource.data.role != 'administrador')
        )
        || (
          request.auth.uid == userId 
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])
        )
      );

      // Solo superadmin puede eliminar usuarios
      allow delete: if isSuperAdmin();
    }

    // ─── COLECCIONES PRINCIPALES (ERP) ───────────────────────────
    
    // Clientes: movido a la sección de Servicios Técnicos
    // para permitir creación pública desde eulerservicios.netlify.app

    match /presupuestos/{presupuestoId} {
      allow read: if isSignedIn();
      // Admin puede todo. Usuarios anónimos pueden crear (formulario público)
      allow create: if isAdmin() || isAnyAuth();
      allow update: if isAdmin() || (isAnyAuth() && resource.data.estado == 'pendiente');
      allow delete: if isAdmin();
    }

    match /obras/{obraId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // Permitir que encuestas públicas actualicen solo el campo 'encuesta'
      // (Un usuario anónimo autenticado puede agregar la encuesta)
      allow update: if isAnyAuth() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encuesta']);
    }

    match /lista_precios/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // Movimientos de stock (entregas / remitos) por cualquier usuario del ERP: solo el contador de stock.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockActualizadoEn']);
    }
    
    match /estandares/{estandarId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stock/{stockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transacciones/{trxId} {
      allow read, write: if isSignedIn();
    }

    match /empresas/{empresaId} {
      allow read, write: if isSignedIn();
    }

    match /comprobantes_compra/{compraId} {
      allow read, write: if isSignedIn();
    }

    match /comprobantes_venta/{ventaId} {
      allow read, write: if isSignedIn();
    }

    // Comprobantes emitidos en HOMOLOGACIÓN de ARCA (sin validez fiscal).
    // Solo los escribe la Cloud Function. arca_ta / arca_locks quedan cerrados (regla base).
    match /arca_pruebas/{pruebaId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /recibos/{reciboId} {
      allow read, write: if isSignedIn();
    }

    // Materiales pagados por el cliente y pendientes de entrega.
    match /materiales_a_favor/{matId} {
      allow read, write: if isSignedIn();
    }

    // Consumo real de materiales en obra (ingeniería de cañería, salidas y devoluciones al depósito).
    // Se registran desde la obra (también técnicos); solo se anulan, nunca se borran.
    match /consumos_obra/{consumoId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anuladoPor', 'anuladoEn', 'motivoAnulacion'])
        && resource.data.estado == 'vigente' && request.resource.data.estado == 'anulado';
      allow delete: if false;
    }

    // Otros gastos imputados a una obra (rentabilidad). Solo admin; no se borran, se anulan.
    match /gastos_obra/{gastoId} {
      allow read, create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'anuladoPor', 'anuladoEn', 'motivoAnulacion'])
        && resource.data.estado == 'vigente' && request.resource.data.estado == 'anulado';
      allow delete: if false;
    }

    // Saldos iniciales de cuenta corriente (migración GesDatta). Solo admin carga/anula.
    match /saldos_iniciales/{saldoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ordenes_pago/{opaId} {
      allow read, write: if isSignedIn();
    }

    match /asientos_contables/{asientoId} {
      allow read, write: if isSignedIn();
    }

    match /cuentas_bancarias/{cuentaId} {
      allow read, write: if isSignedIn();
    }

    match /plan_cuentas/{cuentaId} {
      allow read, write: if isSignedIn();
    }

    match /remitos/{remitoId} {
      allow read, write: if isSignedIn();
    }

    // Remitos de entrega a clientes. El ID aleatorio funciona como token del link de firma:
    // cualquiera con el link puede LEER ese remito (get, no list) y FIRMARLO una sola vez.
    match /remitos_entrega/{remitoId} {
      allow get: if true;
      allow list, create, delete: if isSignedIn();
      allow update: if isSignedIn() || (
        resource.data.estado == 'vigente'
        && resource.data.estadoFirma == 'pendiente'
        && request.resource.data.estadoFirma == 'firmado'
        && request.resource.data.firma.metodo == 'link'
        && request.resource.data.firma.imagen is string
        && request.resource.data.firma.imagen.size() < 400000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoFirma', 'firma', 'firmadoEn'])
      );
    }

    match /cheques/{chequeId} {
      allow read, write: if isSignedIn();
    }

    match /tarjetas_cobrar/{tarjetaId} {
      allow read, write: if isSignedIn();
    }

    match /migraciones_gesdatta/{migId} {
      allow read, write: if isSignedIn();
    }

    match /liquidaciones/{liquidacionId} {
      allow read, write: if isAdmin();
    }

    match /eulerData/{docId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      // Cualquier autenticado real puede crear y marcar como leída
      allow create: if true;
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /encuestas_obra/{encuestaId} {
      // Las encuestas pueden ser creadas desde el exterior
      allow create: if true; 
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ─── SERVICIOS TÉCNICOS ──────────────────────────────────────
    // El formulario público de eulerservicios.netlify.app crea servicios
    // sin autenticación. Debe poder crear documentos sin login.
    
    match /servicios/{servicioId} {
      allow read, create, update: if true;
      allow delete: if isSignedIn();
    }

    match /clientes/{clienteId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /usuarios/{usuarioId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /papelera/{papeleraId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /manuales/{manualId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── CRM Y AUXILIARES ────────────────────────────────────────
    
    match /folletos/{folletoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /crmLabels/{labelId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /metadata/{metadataId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /configuracion/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // Numeraciones correlativas (remitos, recibos, comprobantes X) para cualquier usuario del ERP.
      allow update: if isSignedIn() && configId == 'ventas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['numeracion']);
    }

    match /colaboradores/{colabId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
